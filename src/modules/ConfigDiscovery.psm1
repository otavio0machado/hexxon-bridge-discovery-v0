Set-StrictMode -Version Latest
Import-Module (Join-Path $PSScriptRoot 'LocalPathSafety.psm1')
function Get-DiscoveryConfigHints { param([object]$Application) if(!$Application.path -or -not (Test-IsLocalFixedPath $Application.path)){return @()};$root=Split-Path -Parent $Application.path;if(-not (Test-IsLocalFixedPath $root)){return @()};$product=[IO.Path]::GetFileNameWithoutExtension($Application.executableName);$paths=@($root);foreach($n in 'config','configuration','settings'){$p=Join-Path $root $n;if((Test-IsLocalFixedPath $p) -and (Test-Path -LiteralPath $p)){$paths += $p}};foreach($base in @($env:ProgramData,$env:APPDATA)){if($base -and $product){$p=Join-Path $base $product;if((Test-IsLocalFixedPath $p) -and (Test-Path -LiteralPath $p)){$paths += $p}}};$all=@();foreach($p in ($paths|Select-Object -Unique)){if(-not (Test-IsLocalFixedPath $p)){continue};try{Get-ChildItem -LiteralPath $p -File -ErrorAction SilentlyContinue | Where-Object {$_.Extension -in '.ini','.conf','.config','.xml','.json','.properties','.cfg' -and $_.Length -le 2097152} | ForEach-Object {$all += Get-SafeConfigurationHints -Path $_.FullName};Get-ChildItem -LiteralPath $p -Directory -ErrorAction SilentlyContinue | Where-Object {Test-IsLocalFixedPath $_.FullName} | ForEach-Object {Get-ChildItem -LiteralPath $_.FullName -File -ErrorAction SilentlyContinue | Where-Object {$_.Extension -in '.ini','.conf','.config','.xml','.json','.properties','.cfg' -and $_.Length -le 2097152} | ForEach-Object {$all += Get-SafeConfigurationHints -Path $_.FullName}}}catch{}};return @($all)}
Export-ModuleMember -Function Get-DiscoveryConfigHints
